# Production settings for docker-compose.prod.yml. Development uses backend/.env instead.

# Public host served by Traefik.
PUBLIC_HOST=book-reader.thomashtn.dev

# Existing Traefik on the VPS: its Docker network, HTTPS entrypoint and certificate resolver.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Docker network through which the backend reaches the VPS PostgreSQL 17.
DATABASE_NETWORK=database

# Dedicated database and role on that PostgreSQL (host is its container name on DATABASE_NETWORK).
DB_URL=jdbc:postgresql://postgres:5432/book_reader
DB_USERNAME=book_reader
DB_PASSWORD=change-me

# Typed once in the backoffice, sent as X-Admin-Key. At least 32 characters: `openssl rand -base64 36`.
ADMIN_API_KEY=replace-with-a-long-random-secret-of-32-chars-min

# Failed X-Admin-Key attempts per address before a one-minute lockout.
ADMIN_RATE_LIMIT_MAX_FAILURES=5
ADMIN_RATE_LIMIT_LOCKOUT_DURATION=PT1M

# Ebooks libres et gratuits site root.
CATALOGUE_BASE_URL=https://www.ebooksgratuits.com/

# Swagger UI stays off in production: the document maps every administrative route.
API_DOCS_ENABLED=false
