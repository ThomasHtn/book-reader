# =============================================================================
# Local development settings: `cp .env.example .env` and the backend starts as is.
# Demo administrator key below: never deploy it.
# =============================================================================

# =============================================================================
# Database
# =============================================================================
# PostgreSQL of compose.yaml (`make db`), published on 5433 so it never clashes with a native install.
# Native PostgreSQL instead: jdbc:postgresql://localhost:5432/book_reader and your role's password.
DB_URL=jdbc:postgresql://localhost:5433/book_reader
DB_USERNAME=book_reader
DB_PASSWORD=book_reader

# =============================================================================
# Backoffice
# =============================================================================
# Secret typed once in the backoffice, sent as X-Admin-Key. At least 32 characters. Required.
ADMIN_API_KEY=book-reader-demo-admin-key-0123456789

# Wrong keys allowed per address before a lockout, and the lockout duration.
ADMIN_RATE_LIMIT_MAX_FAILURES=5
ADMIN_RATE_LIMIT_LOCKOUT_DURATION=PT1M

# =============================================================================
# Catalogue
# =============================================================================
# Ebooks libres et gratuits site root; search and download paths are fixed by the site.
CATALOGUE_BASE_URL=https://www.ebooksgratuits.com/

# =============================================================================
# Development switches
# =============================================================================
# Swagger UI at /swagger-ui.html. Local development only: the document maps every admin route.
API_DOCS_ENABLED=true

# Keep `native` behind a proxy: `framework` trusts a client-sent `Forwarded` header and defeats the lockout.
FORWARD_HEADERS_STRATEGY=native
