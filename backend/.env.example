# PostgreSQL connection (a dedicated database and role on the VPS instance in production).
DB_URL=jdbc:postgresql://localhost:5432/book_reader
DB_USERNAME=book_reader
DB_PASSWORD=change-me

# Secret typed once in the backoffice, sent as X-Admin-Key. At least 32 characters.
ADMIN_API_KEY=replace-with-a-long-random-secret-of-32-chars-min

# Failed X-Admin-Key attempts per address before a lockout, and the lockout duration.
ADMIN_RATE_LIMIT_MAX_FAILURES=5
ADMIN_RATE_LIMIT_LOCKOUT_DURATION=PT1M

# Angular dev server allowed by CORS (production is same-origin).
FRONTEND_ORIGIN=http://localhost:4200

# Swagger UI at /swagger-ui.html. Local development only: the document maps every admin route.
API_DOCS_ENABLED=true

# Keep `framework` behind Traefik, or every caller shares the proxy address in the lockout.
FORWARD_HEADERS_STRATEGY=framework
