{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && npm run lint:styles",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\" playwright.config.ts eslint.config.js stylelint.config.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\" playwright.config.ts eslint.config.js stylelint.config.mjs",
    "fix": "ng lint --fix --force && stylelint --fix \"src/**/*.css\" && npm run format",
    "e2e": "playwright test",
    "prepare": "test -x ../scripts/install-git-hooks.sh && ../scripts/install-git-hooks.sh || true"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/service-worker": "^22.2.1",
    "@lucide/angular": "^1.52.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
